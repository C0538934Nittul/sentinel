# Copy to .env and adjust for your local machine. Never commit .env (see root .gitignore).

PORT=3001
MONGODB_URI=mongodb://localhost:27017/sentinel
CLIENT_ORIGIN=http://localhost:3000

# Resolved relative to the repo root at runtime -- see src/config/env.ts. Do not put an
# absolute machine-specific path here.
ANALYZER_BIN_PATH=analyzer/build/debug/sentinel-analyzer
RULES_CONFIG_PATH=config/rules.json

# One of: debug, info, warn, error
LOG_LEVEL=info
