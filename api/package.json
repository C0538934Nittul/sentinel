{
  "name": "@sentinel/api",
  "version": "0.1.0",
  "private": true,
  "description": "Sentinel REST API -- Express + TypeScript, persists events/incidents via MongoDB and integrates the C++ analyzer as a spawned process. See ../README.md and ../docs/data-contract.md.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "express": "^4.19.2",
    "mongoose": "^8.5.0",
    "zod": "^3.23.8",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.4.0",
    "dotenv": "^16.4.5",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "tsx": "^4.16.5",
    "vitest": "^2.0.5",
    "supertest": "^7.0.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.14.15",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3"
  }
}
